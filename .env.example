# Copy this file to .env.local and fill it in. NEVER commit .env.local (it is git-ignored).
# Full reference: docs/ENVIRONMENT.md
#
# LOCAL DEVELOPMENT NEEDS NONE OF THESE. With no DATABASE_URL the app uses an embedded database in .data/
# and writes e-mails (sign-up and password-reset links) to .data/outbox/ instead of sending them.

# ---------------------------------------------------------------------------------------------------
# Required on a real deployment (Vercel -> Project -> Settings -> Environment Variables).
# Use DIFFERENT values for Preview and Production, and ideally a separate Neon branch for Preview.
# ---------------------------------------------------------------------------------------------------

# Neon pooled connection string (the host contains "-pooler"), with sslmode=require.
DATABASE_URL=

# At least 32 random characters. Generate one with:  openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# The public URL of THIS deployment, no trailing slash. e.g. https://grade-delusion.vercel.app
BETTER_AUTH_URL=

# Resend API key, and a sender on a domain you have verified in Resend (SPF + DKIM).
RESEND_API_KEY=
EMAIL_FROM="Grade Delusion <no-reply@your-domain.example>"

# ---------------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------------

# Extra origins allowed to call the auth API (comma separated), e.g. a custom domain next to *.vercel.app.
# AUTH_TRUSTED_ORIGINS=https://www.your-domain.example

# Turn Better Auth's own rate limiter on in development (it is always on in production).
# GD_RATE_LIMIT=1

# Where the local embedded database / dev e-mail outbox live (defaults shown).
# GD_PGLITE_DIR=.data/pglite
# GD_OUTBOX_DIR=.data/outbox

# Run a PRODUCTION BUILD on your own machine with the local fallbacks (used by the end-to-end tests).
# Ignored on Vercel. Never set this on anything that serves real users.
# GD_LOCAL=1
